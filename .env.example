# Session
SESSION_SECRET=change-me-in-production

# Vector store: sqlite (default, local file) or postgres
VECTOR_BACKEND=sqlite
SQLITE_PATH=data/anjz.sqlite
UPLOAD_ROOT=data/uploads
# VECTOR_BACKEND=postgres
# DATABASE_URL=postgres://anjz:anjz@127.0.0.1:5432/anjz

# Embeddings — required for real RAG indexing and retrieval
# Leave empty to disable indexing; empty strings are treated as missing.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# You may reuse OPENAI_API_KEY for both embeddings and LLM:
# OPENAI_API_KEY=

# LLM — required to generate answers from retrieved chunks
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Retention: hard-delete documents and vectors after N days
DOCUMENT_RETENTION_DAYS=365
RAG_MIN_SIMILARITY=0.22
PORT=8787

# AI image generation for the Design Studio (one image per request)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
