# Session
SESSION_SECRET=change-me-in-production

# Vector store: sqlite (default, local file) or postgres
VECTOR_BACKEND=sqlite
SQLITE_PATH=data/anjz.sqlite
UPLOAD_ROOT=data/uploads
# VECTOR_BACKEND=postgres
# DATABASE_URL=postgres://anjz:anjz@127.0.0.1:5432/anjz

# Gemini (server-side only). Get a key from https://aistudio.google.com/api-keys
# Leave GEMINI_API_KEY empty to disable Gemini. Empty strings are treated as missing.
# Model names are configurable; not every account has image generation or every model.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Embeddings — required for real RAG indexing and retrieval.
# With GEMINI_API_KEY set and EMBEDDING_BASE_URL empty, the app calls Gemini embedContent
# (not the OpenAI /v1 embeddings API).
# gemini-embedding-001 supports output dimensions 768, 1536, or 3072.
# Existing Postgres schema is vector(1536). Do not mix models or dimensions in one store.
# If you already have 1536 OpenAI vectors, either keep EMBEDDING_DIMENSIONS=1536
# (supported by gemini-embedding-001) or wipe/re-index before switching to 768.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Optional OpenAI-compatible override (Ollama / OpenAI). If set, that HTTP API is used instead of Gemini:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# LLM — RAG answers and copy fallback when Gemini generateContent is not used.
# With GEMINI_API_KEY set and LLM_BASE_URL empty, the app calls Gemini generateContent.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini-3.8-flash

# Retention: hard-delete documents and vectors after N days
DOCUMENT_RETENTION_DAYS=365
RAG_MIN_SIMILARITY=0.22
PORT=8787


# Optional Supabase Storage for logos (local files are always used)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOGO_BUCKET=company-logos

# Hourly in-process sync/reminders run while the API process is up.
# External scheduler (daily, Asia/Riyadh): POST /api/internal/cron/reminders
# Central occasion confirmation: POST /api/internal/calendar/occasions
# Header: Authorization: Bearer CRON_SECRET
CRON_SECRET=
PLATFORM_SQLITE_PATH=data/platform.sqlite

# Email reminders are not sent unless SMTP_URL is set (unused placeholder)
SMTP_URL=
